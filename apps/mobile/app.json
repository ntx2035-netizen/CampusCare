{
  "expo": {
    "name": "CampusCare",
    "slug": "campus-care",
    "version": "1.0.0",
    "icon": "./assets/campuscare-ictu-logo.png",
    "orientation": "portrait",
    "scheme": "campuscare",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edu.campuscare.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "CampusCare dùng camera để chụp ảnh và quét mã QR địa điểm.",
        "NSLocationWhenInUseUsageDescription": "CampusCare dùng vị trí để xác định nơi xảy ra sự cố.",
        "NSPhotoLibraryUsageDescription": "CampusCare cần chọn ảnh minh chứng sự cố."
      }
    },
    "android": {
      "package": "vn.edu.campuscare.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép CampusCare sử dụng camera để chụp ảnh và quét QR."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép CampusCare chọn ảnh minh chứng."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép CampusCare xác định vị trí sự cố."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087f8c",
          "image": "./assets/campuscare-ictu-logo.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e02adeb-f817-4654-b2d2-2c5709c14ebf"
      }
    },
    "owner": "thiiisuann"
  }
}
